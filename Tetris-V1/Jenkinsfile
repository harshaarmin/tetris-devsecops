pipeline {
    agent any

    tools {
        nodejs 'nodejs'
    }

    options {
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout Source Code') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('Tetris-V1') {
                    sh 'node -v'
                    sh 'npm -v'
                    sh 'npm ci'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('Tetris-V1') {
                    script {
                        def scannerHome = tool 'SonarScanner'

                        withSonarQubeEnv('SonarQube') {
                            sh "${scannerHome}/bin/sonar-scanner"
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('OWASP Dependency-Check') {
            steps {
                dir('Tetris-V1') {
                    dependencyCheck(
                        odcInstallation: 'DP-Check',
                        nvdCredentialsId: 'nvd-api-key',
                        additionalArguments: '--scan . --format XML --disableYarnAudit --suppression dependency-check-suppressions.xml --nvdApiDelay 8000 --nvdMaxRetryCount 15'
                    )
                    dependencyCheckPublisher(
                        pattern: '**/dependency-check-report.xml'
                    )
                }
            }
        }

        stage('Trivy Filesystem Scan') {
            steps {
                dir('Tetris-V1') {
                    sh '''
                        trivy fs \
                            --scanners vuln \
                            --include-dev-deps \
                            --format table \
                            .
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('Tetris-V1') {
                    sh 'docker build -t tetris-app:local .'
                }
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker rm -f tetris-app-local || true
                    docker run -d \
                        --name tetris-app-local \
                        --restart unless-stopped \
                        -p 3000:80 \
                        tetris-app:local
                '''
            }
        }
    }
}